{
  "name": "Monetra - Send Push Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-push-notification",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-send-push",
      "name": "Webhook Send Push",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "monetra-send-push-notification"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\nconst sender_user_id = String(body.sender_user_id || '').trim();\nconst merchant = String(body.merchant || '').trim();\nconst type = String(body.type || '').trim();\nconst total = Number(body.total) || 0;\n\nif (!sender_user_id) throw new Error('sender_user_id is required');\n\nconst amount = total.toLocaleString('id-ID');\nconst typeLabel = type === 'expense' ? 'Pengeluaran' : 'Tabungan';\nconst notif_title = `${sender_user_id} menambahkan transaksi`;\nconst notif_body = `${merchant || 'Transaksi baru'} • ${typeLabel} Rp ${amount}`;\n\nreturn [{ json: { sender_user_id, notif_title, notif_body } }];"
      },
      "id": "parse-push-request",
      "name": "Parse Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/push_tokens?user_id=neq.{{ $json.sender_user_id }}&select=push_token,user_id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_ANON_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{$env.SUPABASE_ANON_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-recipient-tokens",
      "name": "Fetch Recipient Tokens",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nlet pushToken = null;\n\nif (Array.isArray(response)) {\n  if (response.length > 0) pushToken = response[0].push_token;\n} else if (response && response.push_token) {\n  pushToken = response.push_token;\n}\n\nif (!pushToken) return [];\n\nconst parsed = $('Parse Request').first().json;\nreturn [{ json: {\n  to: pushToken,\n  title: parsed.notif_title,\n  body: parsed.notif_body,\n  sound: 'default'\n} }];"
      },
      "id": "extract-token",
      "name": "Extract Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://exp.host/--/api/v2/push/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "send-expo-push",
      "name": "Send Expo Push",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Webhook Send Push": {
      "main": [[{"node": "Parse Request", "type": "main", "index": 0}]]
    },
    "Parse Request": {
      "main": [[{"node": "Fetch Recipient Tokens", "type": "main", "index": 0}]]
    },
    "Fetch Recipient Tokens": {
      "main": [[{"node": "Extract Token", "type": "main", "index": 0}]]
    },
    "Extract Token": {
      "main": [[{"node": "Send Expo Push", "type": "main", "index": 0}]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "instanceId": "monetra-send-push-notification"
  },
  "tags": []
}
